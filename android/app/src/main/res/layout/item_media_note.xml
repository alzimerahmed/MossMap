<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal">

  <TextView
    android:id="@+id/tv_media_note_name"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:ellipsize="middle"
    android:singleLine="true"
    android:textAppearance="@style/MwmTextAppearance.Body1" />

  <ImageView
    android:id="@+id/btn_media_note_open"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/media_notes_open"
    android:focusable="true"
    android:padding="@dimen/margin_half"
    app:srcCompat="@drawable/ic_show"
    app:tint="?colorAccent" />

  <ImageView
    android:id="@+id/btn_media_note_remove"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/media_notes_remove"
    android:focusable="true"
    android:padding="@dimen/margin_half"
    app:srcCompat="@drawable/ic_delete"
    app:tint="?secondary" />
</LinearLayout>
