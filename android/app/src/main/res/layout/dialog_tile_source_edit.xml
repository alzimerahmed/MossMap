<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="@dimen/margin_base"
  android:paddingEnd="@dimen/margin_base"
  android:paddingTop="@dimen/margin_half">

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/tile_source_name_input"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/tile_sources_name_title">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/tile_source_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="text"
      android:maxLines="1" />
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/tile_source_url_input"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_half"
    android:hint="@string/tile_sources_url_title">

    <com.google.android.material.textfield.TextInputEditText
      android:id="@+id/tile_source_url"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:inputType="textUri"
      android:maxLines="1" />
  </com.google.android.material.textfield.TextInputLayout>

  <RadioGroup
    android:id="@+id/tile_source_type"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_half"
    android:orientation="horizontal">

    <RadioButton
      android:id="@+id/tile_source_type_xyz"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:checked="true"
      android:text="@string/tile_sources_type_xyz" />

    <RadioButton
      android:id="@+id/tile_source_type_wms"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/margin_base"
      android:text="@string/tile_sources_type_wms" />
  </RadioGroup>

  <TextView
    android:id="@+id/tile_source_opacity_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_half"
    android:text="@string/tile_sources_opacity_title"
    android:textAppearance="?fontBody2" />

  <com.google.android.material.slider.Slider
    android:id="@+id/tile_source_opacity"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:valueFrom="0"
    android:valueTo="100"
    android:stepSize="5" />

  <TextView
    android:id="@+id/tile_source_opacity_value"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:textAppearance="?fontCaption" />
</LinearLayout>
